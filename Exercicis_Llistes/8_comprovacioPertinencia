# Pregunta a l’usuari un número i comprova si està dins d’una llista.
list_num = [2, 7, 4, 2, 1, 6, 3, 7, 6, 10]
num = int(input("Introduce un número entero: "))
clon = False 
for ele in list_num:
    if ele == num:
        clon = True
        break
if clon:
    print("Tu numero ya estaba dentro de nuestra lista")
else:
    print("Este numero no esta en nuestra lista")